# The exact origin used in your browser (no trailing slash).
APP_URL=http://localhost:3100
PORT=3100
# Use 0.0.0.0 only when you intend to expose the HTTP port to your network.
BIND_IP=127.0.0.1
# Generate with: openssl rand -hex 24
SETUP_TOKEN=replace-with-a-long-random-value
# A contact address for your push signing identity.
VAPID_SUBJECT=mailto:you@example.com
# Keep 0 for a direct connection. Use 1 only behind one trusted reverse proxy.
TRUST_PROXY=0

# Optional sleep coach: any OpenAI-compatible Chat Completions endpoint.
# Keep these server-side. Leave the URL and model blank to disable the coach.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
